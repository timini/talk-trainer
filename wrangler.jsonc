{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talk-trainer",
  // worker.ts: the OpenNext app, plus the build Workflow and the render container.
  "main": "worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Talks, slides, sentences and progress.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talk-trainer",
      "database_id": "a40dbfb9-45dc-44b4-8561-4689ffb52126",
      "migrations_dir": "migrations"
    }
  ],
  // Uploaded decks, slide images and voice clips, in KV (lib/kvfiles.ts) while the account has no R2. To move to R2:
  // npx wrangler r2 bucket create talk-trainer-files, and bind it as FILES; filesOf() then uses it.
  "kv_namespaces": [
    {
      "binding": "FILES_KV",
      "id": "4fcafe8743a646cb801fbe94b0a880f7"
    }
  ],
  // The background build of an uploaded talk (workers/build.ts).
  "workflows": [
    {
      "name": "talk-trainer-build",
      "binding": "BUILD",
      "class_name": "BuildWorkflow"
    }
  ],
  // The slide renderer: LibreOffice and poppler in a container (container/Dockerfile, workers/render.ts).
  "containers": [
    {
      "class_name": "Render",
      "image": "./container/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RENDER", "class_name": "Render" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Render"] }],
  // Secrets, set with `npx wrangler secret put <NAME>` (the value on stdin): GEMINI_KEY, BETA_PASSWORD.
}
